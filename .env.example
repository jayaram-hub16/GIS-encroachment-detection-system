# Flask Secret Key (REQUIRED - generate a long random string)
SECRET_KEY=change-this-to-a-long-random-secret-key-minimum-32-chars

# Database URL
# SQLite (local development only):
DATABASE_URL=sqlite:///municipal.db
# PostgreSQL (production - use this format):
# DATABASE_URL=postgresql://username:password@host:5432/database_name

# Set to "true" when running behind HTTPS (enables Secure cookies)
HTTPS=false

# Server port (default: 5000)
PORT=5000

# Flask environment
FLASK_ENV=production

# ==========================================
# PRODUCTION DEPLOYMENT (Render.com, etc.)
# ==========================================
# 1. Copy this file to .env
# 2. Fill in real values
# 3. NEVER commit .env to version control

# For Render.com, set these in the Environment tab:
# SECRET_KEY = (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# DATABASE_URL = (from Render PostgreSQL Add-On → Internal Database URL)
# HTTPS = true
